{
    "id": "my-api-el",
    "name": "my-api-el",
    "gravitee": "2.0.0",
    "proxy": {
        "context_path": "/test-el",
        "endpoints": [
            {
                "name": "default",
                "target": "http://localhost:8080/endpoint",
                "http": {
                    "connectTimeout": 3000,
                    "readTimeout": 60000
                }
            }
        ]
    },
    "flows": [
        {
            "name": "flow-1",
            "methods": ["GET"],
            "enabled": true,
            "path-operator": {
                "path": "/",
                "operator": "STARTS_WITH"
            },
            "pre": [
                {
                    "name": "Latency policy",
                    "description": "",
                    "enabled": true,
                    "policy": "latency",
                    "configuration": {
                        "time": 0,
                        "dynamicTime": "{#request.headers['X-Latency'][0]}",
                        "timeUnit": "SECONDS"
                    }
                }
            ],
            "post": []
        }
    ]
}

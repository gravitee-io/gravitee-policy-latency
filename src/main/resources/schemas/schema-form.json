{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "time": {
            "title": "Time duration",
            "type": "integer",
            "default": 100,
            "minimum": 0
        },
        "dynamicTime": {
            "title": "Dynamic time duration",
            "description": "EL expression returning the time duration (e.g. {#request.headers['X-Latency'][0]}). When set, it overrides 'Time duration'.",
            "type": "string",
            "x-schema-form": {
                "expression-language": true
            }
        },
        "timeUnit": {
            "title": "Time unit",
            "type": "string",
            "default": "MILLISECONDS",
            "enum": ["MILLISECONDS", "SECONDS"]
        }
    }
}
